# =====================================================================
# 企业知识问答 Agent - 环境变量示例
# 复制为 .env 后修改;agent 启动时会自动读取工作目录下的 .env
# =====================================================================

# ---------- 模型接入(真实模型路径,OpenAI 兼容接口即可) ----------
# 示例:
#   智谱 GLM:  AGENT_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4   AGENT_LLM_MODEL=glm-4-flash
#   DeepSeek:  AGENT_LLM_BASE_URL=https://api.deepseek.com/v1            AGENT_LLM_MODEL=deepseek-chat
#   OpenAI:    AGENT_LLM_BASE_URL=https://api.openai.com/v1              AGENT_LLM_MODEL=gpt-4o-mini
AGENT_LLM_BASE_URL=
AGENT_LLM_API_KEY=
AGENT_LLM_MODEL=

# ---------- Agent 行为 ----------
# 模型引擎选择:
#   auto  = 配置了真实模型(API_KEY+MODEL)则用真实模型,否则自动回退 Mock(会打印边界警告)
#   mock  = 强制使用离线 Mock 决策策略(仅验证流程,不证明真实模型决策效果)
#   real  = 强制使用真实模型(未配置则启动报错)
AGENT_MODEL_ENGINE=auto

# ReAct 循环最大步数(每步 = 一次模型决策 + 一次工具调用/结束),达到上限返回明确的未完成状态
AGENT_MAX_STEPS=8

# 文档库与规则文件路径(JSON)
AGENT_DATA_PATH=data/documents.json
AGENT_RULES_PATH=data/rules.json

# ---------- 故障注入(演示/测试"工具失败"场景,默认关闭) ----------
# 可选值:read_once(首次读取文档失败) / search_once(首次检索失败) / read_all(读取始终失败)
AGENT_INJECT_TOOL_FAILURE=

# ---------- 检索参数 ----------
# 每次检索返回的最大条数
AGENT_TOP_K=4
